FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm install
COPY . .
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
# Configs: TLS (nginx.conf) e fallback HTTP (nginx.http.conf). O
# nginx-entrypoint.sh escolhe conforme a existência do certificado.
COPY nginx.conf /etc/nginx/tls.conf
COPY nginx.http.conf /etc/nginx/http.conf
COPY nginx.staging.conf /etc/nginx/staging.conf
COPY nginx.backend-routes.conf /etc/nginx/snippets/backend-routes.conf
COPY nginx-entrypoint.sh /etc/nginx/nginx-entrypoint.sh
RUN chmod +x /etc/nginx/nginx-entrypoint.sh
EXPOSE 80 443
ENTRYPOINT ["/bin/sh", "/etc/nginx/nginx-entrypoint.sh"]
