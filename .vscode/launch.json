{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Docker: Flask (debugpy)",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "127.0.0.1",
        "port": 5678
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}/backend/catalog_server",
          "remoteRoot": "/app/catalog_server"
        }
      ],
      "justMyCode": true,
      "subProcess": false,
      "preLaunchTask": "Docker: iniciar Flask com debugpy",
      "postDebugTask": "Docker: restaurar backend Gunicorn"
    }
  ]
}
