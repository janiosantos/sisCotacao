+def fmt_qty(value: float | None) -> str:
+    """Formata quantidade sem casas decimais supérfluas: 50.0 -> '50', 2.5 -> '2,5'."""
+    if value is None:
+        return "0"
+    try:
+        v = float(value)
+    except (TypeError, ValueError):
+        return str(value)
+    if v == int(v):
+        return str(int(v))
+    return f"{v:.2f}".rstrip("0").rstrip(".").replace(".", ",")
+
