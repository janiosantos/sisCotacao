@@ -0,0 +1,296 @@
+"""Integração com a API da Tecnospeed (PlugNotas) para emissão de NFC-e
+(modelo 65) e NF-e (modelo 55).
+
+IMPORTANTE — leia antes de configurar credenciais reais:
+Este módulo implementa o formato de payload e os endpoints tal como
+documentados publicamente pela Tecnospeed/PlugNotas no momento em que foi
+escrito (autenticação Bearer, JSON, `POST /nfce` para emitir e
+`GET /nfce/{id}` para consultar). APIs de terceiros mudam; **valide os
+nomes de campo e o contrato exato contra a documentação/sandbox atual da
+Tecnospeed antes de ligar isso em produção** — ver TECNOSPEED.md na raiz
+do projeto.
+
+Por padrão a integração roda em MODO SIMULADO (`tecnospeed_config.simulado
+= '1'`): nenhuma chamada de rede é feita, e a emissão retorna um resultado
+simulado de "autorizado" na hora, para que todo o resto do fluxo (Caixa,
+guarda em `documentos_fiscais`, exibição de status) seja testável sem
+credenciais. Desligar o modo simulado exige token + CNPJ do emitente
+cadastrados em `tecnospeed_config`.
+"""
+from __future__ import annotations
+
+import uuid
+from typing import Any
+
+import requests
+
+from catalog_server.db import system_conn
+from catalog_server.repositories import emitente_repo
+from catalog_server.repositories.fiscal_documentos import (
+    documento_fiscal_repo,
+    tecnospeed_config_repo,
+)
+from catalog_server.repositories.orcamentos import orcamento_repo
+
+BASE_URL = {
+    "homologacao": "https://api.sandbox.tecnospeed.com.br/v1",
+    "producao": "https://api.tecnospeed.com.br/v1",
+}
+
+# Mapeia a forma de pagamento interna do sistema para o código de meio de
+# pagamento do SAT/NFC-e (tabela oficial da SEFAZ, usada por qualquer
+# emissor — inclusive a Tecnospeed).
+CODIGO_PAGAMENTO_SEFAZ = {
+    "dinheiro": "01",
+    "cheque": "02",
+    "cartao_credito": "03",
+    "cartao_debito": "04",
+    "credito_loja": "05",
+    "vale_alimentacao": "10",
+    "vale_refeicao": "11",
+    "vale_presente": "12",
+    "vale_combustivel": "13",
+    "boleto": "15",
+    "pix": "17",
+    "convenio": "99",
+    "outros": "99",
+}
+
+
+class TecnospeedError(Exception):
+    pass
+
+
+def _headers(token: str) -> dict:
+    return {"Authorization": f"Bearer {token}", "Content-Type": "application/json"}
+
+
+def _pagamentos_do_orcamento(orcamento_id: int) -> list[dict]:
+    """Os pagamentos de uma venda ficam em `caixa_movimento` (lançamentos de
+    entrada vinculados ao orçamento), não no próprio registro do orçamento."""
+    with system_conn() as conn:
+        rows = conn.execute(
+            "SELECT forma_pagamento, valor FROM caixa_movimento"
+            " WHERE orcamento_id=? AND tipo='entrada' ORDER BY id",
+            (orcamento_id,),
+        ).fetchall()
+        return [dict(r) for r in rows]
+
+
+def _snapshot_fiscal_por_item(orcamento_id: int) -> dict[int, dict]:
+    """NCM/CFOP/CST/alíquotas gravados no momento da finalização (fonte
+    oficial para a nota — não usar o cadastro atual do produto, que pode
+    ter mudado desde a venda)."""
+    with system_conn() as conn:
+        rows = conn.execute(
+            "SELECT * FROM orcamento_itens_fiscal WHERE orcamento_id=?", (orcamento_id,)
+        ).fetchall()
+        return {r["item_id"]: dict(r) for r in rows}
+
+
+def montar_payload_nfce(orcamento: dict, emitente: dict) -> dict[str, Any]:
+    """Constrói o corpo JSON de emissão a partir do orçamento faturado e do
+    cadastro do emitente. Consumidor final sem CPF/CNPJ informado é
+    permitido (comum em NFC-e de balcão)."""
+    snapshots = _snapshot_fiscal_por_item(orcamento["id"])
+    itens = []
+    for idx, it in enumerate(orcamento.get("itens", []), start=1):
+        fiscal = snapshots.get(it.get("id"), {})
+        itens.append({
+            "numeroItem": idx,
+            "codigo": it.get("sku") or f"ITEM{idx}",
+            "descricao": it.get("nome") or "",
+            "ncm": fiscal.get("ncm") or "00000000",
+            "cfop": fiscal.get("cfop") or "5102",
+            "unidade": "UN",
+            "quantidade": float(it.get("quantidade") or 0),
+            "valorUnitario": float(it.get("preco_unitario") or 0),
+            "valorTotal": float(it.get("subtotal") or 0),
+            "icms": {
+                "situacaoTributaria": fiscal.get("cst_icms") or fiscal.get("csosn") or "102",
+                "aliquota": float(fiscal.get("aliquota_icms") or 0),
+            },
+        })
+
+    pagamentos = _pagamentos_do_orcamento(orcamento["id"])
+    formas_pagamento = [
+        {
+            "meioPagamento": CODIGO_PAGAMENTO_SEFAZ.get(p.get("forma_pagamento", ""), "99"),
+            "valorPago": float(p.get("valor") or 0),
+        }
+        for p in pagamentos
+    ] or [{"meioPagamento": "99", "valorPago": float(orcamento.get("total") or 0)}]
+
+    payload: dict[str, Any] = {
+        "idIntegracao": f"orc-{orcamento['id']}-{uuid.uuid4().hex[:8]}",
+        "presencial": True,
+        "emitente": {
+            "cpfCnpj": (emitente.get("cnpj") or "").replace(".", "").replace("/", "").replace("-", ""),
+            "inscricaoEstadual": emitente.get("ie") or "",
+        },
+        "itens": itens,
+        "pagamentos": formas_pagamento,
+        "valorTotal": float(orcamento.get("total") or 0),
+        "informacoesAdicionais": f"Venda ref. orçamento {orcamento.get('numero', '')}",
+    }
+
+    cliente_doc = (orcamento.get("cliente_doc") or "").strip()
+    if cliente_doc:
+        payload["destinatario"] = {
+            "cpfCnpj": cliente_doc.replace(".", "").replace("/", "").replace("-", ""),
+            "nome": orcamento.get("cliente") or "",
+        }
+
+    return payload
+
+
+def _resposta_simulada(payload: dict) -> dict:
+    """Simula uma autorização instantânea, no mesmo formato (reduzido) que
+    a API real devolveria — permite testar o fluxo ponta a ponta sem rede."""
+    chave_fake = "SIMULADO" + uuid.uuid4().hex[:36].upper()
+    return {
+        "id": f"sim-{uuid.uuid4().hex[:12]}",
+        "status": "autorizado",
+        "chaveAcesso": chave_fake[:44],
+        "numeroProtocolo": "SIMULADO-" + uuid.uuid4().hex[:10],
+        "numero": None,
+        "serie": None,
+        "xmlUrl": None,
+        "danfeUrl": None,
+        "motivo": "Emissão simulada (TECNOSPEED_SIMULADO ativo) — configure credenciais reais para emitir de verdade.",
+    }
+
+
+def emitir_nfce(orcamento_id: int) -> dict:
+    """Emite (ou reemite, se a tentativa anterior falhou) a NFC-e de um
+    orçamento faturado. Retorna o registro de `documentos_fiscais`
+    atualizado."""
+    orc = orcamento_repo.buscar(orcamento_id)
+    if orc is None:
+        raise TecnospeedError("Orçamento não encontrado")
+    if orc.get("status") not in ("faturado", "recebido"):
+        raise TecnospeedError("Só é possível emitir NFC-e para um orçamento faturado/recebido")
+
+    existente = documento_fiscal_repo.get_by_orcamento(orcamento_id, "65")
+    if existente and existente["status"] in ("autorizado", "processando"):
+        return existente
+
+    emitente = emitente_repo.get() or {}
+    cfg = tecnospeed_config_repo.get_all()
+    ambiente = cfg.get("ambiente", "homologacao")
+    payload = montar_payload_nfce(orc, emitente)
+
+    doc_id = documento_fiscal_repo.criar_ou_reiniciar(orcamento_id, "65", ambiente, payload)
+
+    if tecnospeed_config_repo.simulado():
+        resp = _resposta_simulada(payload)
+    else:
+        token = cfg.get("token", "")
+        if not token:
+            documento_fiscal_repo.atualizar(doc_id, status="erro", motivo="Token da Tecnospeed não configurado")
+            raise TecnospeedError(
+                "Integração não está em modo simulado, mas não há token configurado "
+                "(configure em Configurações → Tecnospeed, ou reative o modo simulado)."
+            )
+        try:
+            r = requests.post(
+                f"{BASE_URL[ambiente]}/nfce",
+                json=payload,
+                headers=_headers(token),
+                timeout=30,
+            )
+            r.raise_for_status()
+            resp = r.json()
+        except requests.RequestException as e:
+            documento_fiscal_repo.atualizar(doc_id, status="erro", motivo=str(e))
+            raise TecnospeedError(f"Falha ao comunicar com a Tecnospeed: {e}") from e
+
+    documento_fiscal_repo.atualizar(
+        doc_id,
+        status=_normalizar_status(resp.get("status")),
+        tecnospeed_id=resp.get("id"),
+        chave_acesso=resp.get("chaveAcesso"),
+        protocolo=resp.get("numeroProtocolo"),
+        numero=resp.get("numero"),
+        serie=resp.get("serie"),
+        motivo=resp.get("motivo"),
+        xml_url=resp.get("xmlUrl"),
+        danfe_url=resp.get("danfeUrl"),
+        resposta_bruta=str(resp),
+    )
+    return documento_fiscal_repo.get(doc_id)
+
+
+def _normalizar_status(status_tecnospeed: str | None) -> str:
+    m = {
+        "autorizado": "autorizado",
+        "authorized": "autorizado",
+        "rejeitado": "rejeitado",
+        "rejected": "rejeitado",
+        "cancelado": "cancelado",
+        "cancelled": "cancelado",
+        "processando": "processando",
+        "processing": "processando",
+        "pending": "processando",
+    }
+    return m.get((status_tecnospeed or "").lower(), "processando")
+
+
+def consultar_status(doc_id: int) -> dict:
+    """Reconsulta o status na Tecnospeed (útil quando ficou 'processando' —
+    emissão assíncrona) e atualiza o registro local."""
+    doc = documento_fiscal_repo.get(doc_id)
+    if doc is None:
+        raise TecnospeedError("Documento fiscal não encontrado")
+    if doc["status"] != "processando":
+        return doc
+    if tecnospeed_config_repo.simulado() or not doc.get("tecnospeed_id"):
+        return doc
+
+    cfg = tecnospeed_config_repo.get_all()
+    token = cfg.get("token", "")
+    ambiente = doc.get("ambiente", "homologacao")
+    try:
+        r = requests.get(
+            f"{BASE_URL[ambiente]}/nfce/{doc['tecnospeed_id']}",
+            headers=_headers(token),
+            timeout=30,
+        )
+        r.raise_for_status()
+        resp = r.json()
+    except requests.RequestException as e:
+        raise TecnospeedError(f"Falha ao consultar status na Tecnospeed: {e}") from e
+
+    documento_fiscal_repo.atualizar(
+        doc_id,
+        status=_normalizar_status(resp.get("status")),
+        chave_acesso=resp.get("chaveAcesso") or doc.get("chave_acesso"),
+        protocolo=resp.get("numeroProtocolo") or doc.get("protocolo"),
+        motivo=resp.get("motivo"),
+        xml_url=resp.get("xmlUrl") or doc.get("xml_url"),
+        danfe_url=resp.get("danfeUrl") or doc.get("danfe_url"),
+        resposta_bruta=str(resp),
+    )
+    return documento_fiscal_repo.get(doc_id)
+
+
+def processar_webhook(payload: dict) -> None:
+    """Recebe notificações assíncronas de mudança de status (a Tecnospeed
+    chama essa rota quando uma NFC-e que ficou 'processando' é autorizada
+    ou rejeitada pela SEFAZ)."""
+    tecnospeed_id = payload.get("id") or payload.get("idIntegracao")
+    if not tecnospeed_id:
+        return
+    doc = documento_fiscal_repo.get_by_tecnospeed_id(tecnospeed_id)
+    if doc is None:
+        return
+    documento_fiscal_repo.atualizar(
+        doc["id"],
+        status=_normalizar_status(payload.get("status")),
+        chave_acesso=payload.get("chaveAcesso") or doc.get("chave_acesso"),
+        protocolo=payload.get("numeroProtocolo") or doc.get("protocolo"),
+        motivo=payload.get("motivo"),
+        xml_url=payload.get("xmlUrl") or doc.get("xml_url"),
+        danfe_url=payload.get("danfeUrl") or doc.get("danfe_url"),
+        resposta_bruta=str(payload),
+    )
