{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Docker: iniciar Flask com debugpy",
      "type": "process",
      "command": "docker",
      "args": [
        "compose",
        "-f",
        "${workspaceFolder}/docker-compose.yml",
        "-f",
        "${workspaceFolder}/docker-compose.debug.yml",
        "up",
        "-d",
        "--build",
        "--no-deps",
        "backend"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
