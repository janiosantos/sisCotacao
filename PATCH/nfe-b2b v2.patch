+const STATUS_NFCE_LABEL: Record<string, string> = {
+  nao_emitido: "Não emitida",
+  pendente: "Pendente",
+  processando: "Processando na SEFAZ…",
+  autorizado: "Autorizada",
+  rejeitado: "Rejeitada",
+  cancelado: "Cancelada",
+  erro: "Erro na emissão",
+};
+
+const STATUS_NFCE_TONE: Record<string, "gray" | "green" | "amber" | "red"> = {
+  nao_emitido: "gray",
+  pendente: "amber",
+  processando: "amber",
+  autorizado: "green",
+  rejeitado: "red",
+  cancelado: "gray",
+  erro: "red",
+};
+
+/**
+ * Emissão de NFC-e (modelo 65) via Tecnospeed, aberta logo depois que o
+ * recebimento da venda é confirmado no Caixa. Em modo simulado (padrão,
+ * até alguém configurar credenciais reais em Configurações → Tecnospeed),
+ * a autorização é instantânea; em produção, faz polling enquanto o status
+ * ficar "processando" (emissão é assíncrona na SEFAZ).
+ */
+function ModalEmitirNfce({
+  orcamentoId,
+  numero,
+  onClose,
+}: {
+  orcamentoId: number;
+  numero: string;
+  onClose: () => void;
+}) {
+  const [doc, setDoc] = useState<DocumentoFiscal | { status: "nao_emitido" } | null>(null);
+  const [emitindo, setEmitindo] = useState(false);
+
+  useEffect(() => {
+    void api.statusNfce(orcamentoId).then(setDoc).catch(() => setDoc({ status: "nao_emitido" }));
+  }, [orcamentoId]);
+
+  // Enquanto "processando" (emissão assíncrona), consulta de novo a cada 4s.
+  useEffect(() => {
+    if (!doc || doc.status !== "processando") return;
+    const t = setInterval(() => {
+      void api.statusNfce(orcamentoId).then(setDoc);
+    }, 4000);
+    return () => clearInterval(t);
+  }, [doc, orcamentoId]);
+
+  const emitir = async () => {
+    setEmitindo(true);
+    try {
+      const res = await api.emitirNfce(orcamentoId);
+      setDoc(res);
+      if (res.status === "autorizado") toast("NFC-e autorizada", "success");
+      else if (res.status === "rejeitado") toast("NFC-e rejeitada: " + (res.motivo || ""), "error");
+    } catch (e) {
+      toast("Erro ao emitir NFC-e: " + (e as Error).message, "error");
+    } finally {
+      setEmitindo(false);
+    }
+  };
+
+  const status = doc?.status ?? "nao_emitido";
+  const full = doc && "chave_acesso" in doc ? doc : null;
+
+  return (
+    <Modal
+      open
+      onClose={onClose}
+      title={`Emitir NFC-e — Pedido ${numero}`}
+      footer={
+        <>
+          <Button onClick={onClose}>{status === "autorizado" ? "Fechar" : "Emitir depois"}</Button>
+          {status !== "autorizado" && (
+            <Button variant="primary" onClick={() => void emitir()} disabled={emitindo || status === "processando"}>
+              {emitindo ? "Emitindo…" : status === "rejeitado" || status === "erro" ? "Tentar novamente" : "Emitir NFC-e"}
+            </Button>
+          )}
+        </>
+      }
+    >
+      <div className="mb-4 flex items-center gap-2">
+        <span className="text-sm text-gray-500">Status:</span>
+        <Badge tone={STATUS_NFCE_TONE[status] || "gray"}>{STATUS_NFCE_LABEL[status] || status}</Badge>
+      </div>
+
+      {full?.chave_acesso && (
+        <div className="mb-3 rounded-lg border border-gray-200 bg-gray-50 p-3 text-sm">
+          <div className="mb-1 text-xs font-medium uppercase text-gray-500">Chave de acesso</div>
+          <div className="break-all font-mono text-xs">{full.chave_acesso}</div>
+          {full.protocolo && <div className="mt-2 text-xs text-gray-500">Protocolo: {full.protocolo}</div>}
+        </div>
+      )}
+
+      {full?.danfe_url && (
+        <a
+          href={full.danfe_url}
+          target="_blank"
+          rel="noreferrer"
+          className="mb-3 inline-block rounded-md bg-orange-600 px-4 py-2 text-sm font-medium text-white hover:bg-orange-700"
+        >
+          Ver DANFE (imprimir/baixar)
+        </a>
+      )}
+
+      {(status === "rejeitado" || status === "erro") && full?.motivo && (
+        <p className="rounded-md bg-red-50 p-3 text-sm text-red-700">{full.motivo}</p>
+      )}
+
+      {status === "nao_emitido" && (
+        <p className="text-sm text-gray-500">
+          A venda foi recebida. Emita a NFC-e agora, ou feche e emita depois pela lista de pedidos.
+        </p>
+      )}
+    </Modal>
+  );
+}
