{
  "openapi": "3.0.3",
  "info": {
    "title": "sisCotacao — API",
    "description": "Contrato dos endpoints principais do ERP (fase 1). Autenticação por Bearer token emitido em /api/login (TTL 7 dias). Portal do fornecedor usa token próprio na URL e está fora deste contrato.",
    "version": "v1"
  },
  "servers": [{ "url": "/", "description": "Mesma origem (nginx proxy /api)" }],
  "security": [{ "bearerAuth": [] }],
  "tags": [
    { "name": "infra", "description": "Liveness/readiness (abertos)" },
    { "name": "auth", "description": "Autenticação (abertos)" },
    { "name": "sistema", "description": "Versionamento e atualizações" },
    { "name": "flags", "description": "Feature flags" },
    { "name": "produtos", "description": "Importação de produto por URL" }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "tags": ["infra"],
        "summary": "Liveness do container (não checa o banco)",
        "security": [],
        "responses": {
          "200": { "description": "Processo vivo", "content": { "application/json": { "schema": { "type": "object", "properties": { "status": { "type": "string", "example": "ok" } } } } } }
        }
      }
    },
    "/api/pronto": {
      "get": {
        "tags": ["infra"],
        "summary": "Readiness real — executa SELECT 1 no banco",
        "security": [],
        "responses": {
          "200": { "description": "Sistema utilizável", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProntoOK" } } } },
          "503": { "description": "Banco indisponível", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Erro" } } } }
        }
      }
    },
    "/api/login": {
      "post": {
        "tags": ["auth"],
        "summary": "Autentica e emite o token da sessão",
        "security": [],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginIn" } } }
        },
        "responses": {
          "200": { "description": "Autenticado", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginOut" } } } },
          "401": { "description": "Credenciais inválidas ou usuário inativo", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Erro" } } } }
        }
      }
    },
    "/api/logout": {
      "post": {
        "tags": ["auth"],
        "summary": "Encerra a sessão local (token é client-side)",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/sistema/status": {
      "get": {
        "tags": ["sistema"],
        "summary": "Versão app × schema e pendências por risco",
        "responses": {
          "200": { "description": "Estado de atualização", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SistemaStatus" } } } },
          "401": { "$ref": "#/components/responses/NaoAutenticado" },
          "500": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Erro" } } }, "description": "Erro de infraestrutura" }
        }
      }
    },
    "/api/sistema/updates/apply": {
      "post": {
        "tags": ["sistema"],
        "summary": "Aplica migrações pendentes por nível de risco",
        "requestBody": {
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApplyIn" } } }
        },
        "responses": {
          "200": { "description": "Migrações aplicadas (ou nada pendente)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SistemaStatus" } } } },
          "500": { "description": "Falha ao aplicar", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Erro" } } } }
        }
      }
    },
    "/api/sistema/updates/log": {
      "get": {
        "tags": ["sistema"],
        "summary": "Histórico de atualizações aplicadas (últimos 50)",
        "responses": {
          "200": { "description": "Eventos mais recentes primeiro", "content": { "application/json": { "schema": { "type": "object", "properties": { "log": { "type": "array", "items": { "$ref": "#/components/schemas/AtualizacaoLog" } } } } } } },
          "500": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Erro" } } }, "description": "Erro de infraestrutura" }
        }
      }
    },
    "/api/sistema/releases/pendentes": {
      "get": {
        "tags": ["sistema"],
        "summary": "Manifestos de release ainda não publicados",
        "responses": {
          "200": { "description": "Rascunhos acumulados em dev", "content": { "application/json": { "schema": { "type": "object", "properties": { "pendentes": { "type": "array", "items": { "$ref": "#/components/schemas/Manifesto" } } } } } } },
          "500": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Erro" } } }, "description": "Erro de infraestrutura" }
        }
      }
    },
    "/api/flags": {
      "get": {
        "tags": ["flags"],
        "summary": "Feature flags registradas com estado atual",
        "responses": {
          "200": { "description": "Lista das flags do registro oficial", "content": { "application/json": { "schema": { "type": "object", "properties": { "flags": { "type": "array", "items": { "$ref": "#/components/schemas/FeatureFlag" } } } } } } }
        }
      }
    },
    "/api/flags/{nome}": {
      "put": {
        "tags": ["flags"],
        "summary": "Liga/desliga uma flag registrada (rollback comportamental)",
        "parameters": [{ "name": "nome", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["ativo"], "properties": { "ativo": { "type": "boolean" } } } } }
        },
        "responses": {
          "200": { "description": "Estado gravado", "content": { "application/json": { "schema": { "type": "object", "properties": { "ok": { "type": "boolean" }, "nome": { "type": "string" }, "ativo": { "type": "boolean" } } } } } },
          "404": { "description": "Flag não registrada", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Erro" } } } }
        }
      }
    },
    "/api/produtos-cadastro/parse-url": {
      "post": {
        "tags": ["produtos"],
        "summary": "Baixa a página do produto e devolve preview para conferência",
        "description": "Requer página de produto; usa os parsers por domínio. Timeout de rede: 40s.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["url"], "properties": { "url": { "type": "string", "format": "uri" } } } } }
        },
        "responses": {
          "200": { "description": "Preview estruturado do produto", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ParsePreview" } } } },
          "400": { "description": "URL ausente/inválida ou produto não identificado", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Erro" } } } }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "HMAC (base64.payload.signature), TTL 7 dias" }
    },
    "responses": {
      "NaoAutenticado": {
        "description": "Token ausente, inválido ou expirado",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Erro" } } }
      }
    },
    "schemas": {
      "Erro": {
        "type": "object",
        "properties": { "error": { "type": "string" }, "code": { "type": "string", "example": "db_indisponivel" } }
      },
      "ProntoOK": {
        "type": "object",
        "properties": { "pronto": { "type": "boolean", "example": true } }
      },
      "LoginIn": {
        "type": "object",
        "required": ["login", "senha"],
        "properties": { "login": { "type": "string" }, "senha": { "type": "string", "format": "password" } }
      },
      "LoginOut": {
        "type": "object",
        "properties": {
          "autenticado": { "type": "boolean", "example": true },
          "token": { "type": "string", "description": "Bearer para as demais rotas" },
          "id": { "type": "integer" },
          "nome": { "type": "string" },
          "login": { "type": "string" },
          "perfil": { "type": "string", "enum": ["admin", "vendedor"] }
        }
      },
      "ApplyIn": {
        "type": "object",
        "properties": { "risco": { "type": "string", "enum": ["critica", "rotina", "melhoria", "todos"], "default": "todos" } }
      },
      "MigracaoPendente": {
        "type": "object",
        "properties": {
          "version": { "type": "integer" },
          "name": { "type": "string" },
          "risco": { "type": "string", "enum": ["critica", "melhoria", "rotina", "n/c"] },
          "mudanca": { "type": "object", "nullable": true, "properties": { "o_que": { "type": "array", "items": { "type": "string" } }, "porque": { "type": "array", "items": { "type": "string" } }, "novidades": { "type": "array", "items": { "type": "string" } } } }
        }
      },
      "SistemaStatus": {
        "type": "object",
        "properties": {
          "app_version": { "type": "string" },
          "schema_version": { "type": "integer" },
          "schema_max": { "type": "integer" },
          "applied": { "type": "integer" },
          "total_migrations": { "type": "integer" },
          "pending": { "type": "array", "items": { "$ref": "#/components/schemas/MigracaoPendente" } },
          "pending_por_risco": { "type": "object", "additionalProperties": { "type": "integer" } },
          "atualizado": { "type": "boolean" },
          "ok": { "type": "boolean", "description": "presente em updates/apply" },
          "nivel": { "type": "string", "description": "presente em updates/apply" }
        }
      },
      "AtualizacaoLog": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "executado_em": { "type": "string" },
          "nivel": { "type": "string" },
          "versao_app": { "type": "string" },
          "schema_antes": { "type": "integer" },
          "schema_depois": { "type": "integer" },
          "total_aplicadas": { "type": "integer" },
          "origem": { "type": "string", "enum": ["deploy", "painel", "release"] },
          "usuario": { "type": "string", "nullable": true },
          "erro": { "type": "string", "nullable": true },
          "versao_release": { "type": "string", "nullable": true },
          "componentes": { "type": "array", "items": { "type": "string" }, "nullable": true },
          "correcoes": { "type": "array", "items": { "type": "string" }, "nullable": true },
          "melhorias": { "type": "array", "items": { "type": "string" }, "nullable": true },
          "recursos": { "type": "array", "items": { "type": "string" }, "nullable": true }
        }
      },
      "Manifesto": {
        "type": "object",
        "properties": {
          "versao": { "type": "string" },
          "componentes": { "type": "array", "items": { "type": "string" } },
          "correcoes": { "type": "array", "items": { "type": "string" } },
          "melhorias": { "type": "array", "items": { "type": "string" } },
          "recursos": { "type": "array", "items": { "type": "string" } }
        }
      },
      "FeatureFlag": {
        "type": "object",
        "properties": {
          "nome": { "type": "string" },
          "descricao": { "type": "string" },
          "ativo": { "type": "boolean" }
        }
      },
      "ParsePreview": {
        "type": "object",
        "properties": {
          "url": { "type": "string" },
          "nome": { "type": "string" },
          "sku": { "type": "string" },
          "ean": { "type": "string" },
          "marca": { "type": "string" },
          "cor": { "type": "string" },
          "preco": { "type": "number", "nullable": true },
          "preco_de": { "type": "number", "nullable": true },
          "preco_pix": { "type": "number", "nullable": true },
          "parcelamento": { "type": "string" },
          "fotos": { "type": "integer" },
          "family_key": { "type": "string", "nullable": true },
          "familia_nome": { "type": "string" },
          "base": { "type": "string" },
          "atributos": { "type": "array", "items": { "type": "object", "properties": { "label": { "type": "string" }, "valor": { "type": "string" } } } }
        }
      }
    }
  }
}
